{
  "name": "remotion-cli",
  "version": "1.0.0",
  "description": "Remotion CLI for video generation",
  "bin": "src/cli/index.ts",
  "pkg": {
    "scripts": ["src/**/*.ts", "src/**/*.tsx"],
    "assets": [
      "remotion.config.ts",
      "public/**/*",
      "content/**/*",
      "audio-cache/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64",
      "node18-linux-x64"
    ],
    "outputPath": "src-tauri/binaries",
    "compress": "GZip"
  }
}
