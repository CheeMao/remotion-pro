{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "轻剪",
  "version": "0.1.0",
  "identifier": "com.videomaker.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev:app",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "轻剪",
        "width": 580,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/runtime/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cli"]
  }
}
