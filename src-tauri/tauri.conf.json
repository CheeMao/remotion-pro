{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VideoMaker",
  "version": "0.1.0",
  "identifier": "com.videomaker.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev:app",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "AI 视频生成器",
        "width": 980,
        "height": 700,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
