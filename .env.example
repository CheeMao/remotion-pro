# 火山引擎TTS配置
# 获取地址: https://console.volcengine.com/speech/app/
VOLCENGINE_APP_ID=your_app_id_here
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_RESOURCE_ID=seed-tts-1.0

# NetVerify 授权验证
# 如不填写，将默认使用桌面端内置的示例服务地址和 app_id
NETVERIFY_BASE_URL=http://yz.ledougc.com/api
NETVERIFY_APP_ID=1

# 七牛云配置（用于音频存储）
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your_bucket_name
QINIU_DOMAIN=https://your-public-domain.example.com
QINIU_UPLOAD_URL=https://up.qiniup.com
